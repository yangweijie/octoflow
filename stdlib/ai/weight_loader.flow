// weight_loader.flow — GGUF Weight Loader for LLM Inference
//
// Reads tensors straight from the GGUF file through a Rust MEM buffer, dequantizes to F32, and
// hands arrays back to the caller. One block decoder per ggml format: this module used to carry a
// second set of readers that decoded from an in-memory byte array, and the two copies of the same
// format drifted (the Q6_K row decoder was the one that survived longest). The byte-array set is
// gone; everything reads through the file.
//
// A model map parsed from an in-memory byte array (gguf_load_from_bytes) cannot drive these readers:
// they resolve a tensor offset through the parser MEM buffers (_hdr_buf/_ds_buf), which only
// gguf_load_from_file fills. Write the bytes out and parse the file if you need weights from it.
//
// Uses FLAT key API from gguf.flow — no nested maps.
// Tensor info stored as: t.NAME.type, t.NAME.offset, t.NAME.count, etc.
//
// Decodes: F32, F16, BF16, Q4_0, Q4_1, Q5_0, Q5_1, Q8_0, Q2_K, Q4_K, Q5_K, Q6_K, TQ1_0, TQ2_0 and
// Q2_0_g128 (PQ2_0). Every block layout was checked
// element-by-element against ggml's own dequantization: stdlib/llm/test_dequant.flow for Q5_0,
// Q8_0 and Q6_K, stdlib/llm/test_dequant_more.flow for Q4_0, Q4_1, Q5_1 and Q5_K.
// Anything else, Q5_K and the IQ family included, stops with a message naming the tensor and its
// type rather than returning zeros — for a whole tensor use the gguf_load_tensor() Rust builtin.
//
// Functions (first argument is always the GGUF file path):
//   load_tensor_from_file(file_path, model, tname) → float array, whole tensor
//   load_embedding_row_from_file(file_path, model, token_id, n_embd) → one embedding row
//   load_tensor_row_from_file(file_path, model, tname, row_idx, row_size) → one row of any 2-D tensor
//   load_output_norm(file_path, model) → float array
//   load_output_proj(file_path, model) → float array (falls back to the tied embedding table)
//   read_tensor_by_name(file_path, model, tname) → float array
//
// Requirements: --allow-read (for GGUF file access)

use "../formats/gguf"

// ── Layer Weight Loading ───────────────────────────────────────
// NOTE: OctoFlow maps can only store scalars (Float/Str), NOT arrays. So weights are not
// bundled into a map; each one is read by name with read_tensor_by_name() and passed on
// directly. Every format below has exactly one block decoder, in the MEM section.

fn load_output_norm(file_path, model)
  // Load final RMSNorm weights
  let norm_name = "output_norm.weight"
  if gguf_has_tensor(model, norm_name) == 1.0
    return load_tensor_from_file(file_path, model, norm_name)
  end

  print("WARNING: output_norm.weight not found")
  let mut _empty_arr = []
  return _empty_arr
end

fn load_output_proj(file_path, model)
  // Load lm_head projection weights (vocab x n_embd)
  let out_name = "output.weight"
  if gguf_has_tensor(model, out_name) == 1.0
    return load_tensor_from_file(file_path, model, out_name)
  end

  // Some models tie embedding and output weights
  let emb_name = "token_embd.weight"
  if gguf_has_tensor(model, emb_name) == 1.0
    print("NOTE: Using tied embedding weights for output projection")
    return load_tensor_from_file(file_path, model, emb_name)
  end

  print("WARNING: output.weight not found")
  let mut _empty_arr2 = []
  return _empty_arr2
end

// ── Convenience: Read tensor by name ───────────────────────────

fn read_tensor_by_name(file_path, model, tname)
  if gguf_has_tensor(model, tname) == 1.0
    return load_tensor_from_file(file_path, model, tname)
  end

  print("WARNING: tensor not found: {tname}")
  let mut _ea2 = []
  return _ea2
end


fn tensor_name(layer_idx, suffix)
  // Build GGUF tensor name: "blk.{N}.{suffix}"
  return "blk." + str(layer_idx) + "." + suffix
end

// ══════════════════════════════════════════════════════════════════════
// FILE-BASED TENSOR LOADING — reads from file via MEM_TABLE, no OOM.
// For use with gguf_load_from_file() models.
// ══════════════════════════════════════════════════════════════════════

// ── MEM-based F16 decode ─────────────────────────────────────────

fn read_f16_le_m(buf, offset)
  let b0 = mem_get_u8(buf, offset)
  let b1 = mem_get_u8(buf, offset + 1.0)
  let bits = b0 + b1 * 256.0
  let sign_bit = floor(bits / 32768.0)
  let remainder = bits - sign_bit * 32768.0
  let exp_bits = floor(remainder / 1024.0)
  let mantissa_bits = remainder - exp_bits * 1024.0
  if exp_bits == 0.0
    if mantissa_bits == 0.0
      return 0.0
    end
    let val = mantissa_bits / 1024.0 * pow(2.0, -14.0)
    if sign_bit == 1.0
      return val * -1.0
    end
    return val
  elif exp_bits == 31.0
    return 0.0
  end
  let val = (1.0 + mantissa_bits / 1024.0) * pow(2.0, exp_bits - 15.0)
  if sign_bit == 1.0
    return val * -1.0
  end
  return val
end

// ── MEM-based Q4_K dequant ───────────────────────────────────────

fn get_scale_min_k4_m(j, buf, scales_off)
  let mut sm = [0.0, 0.0]
  if j < 4.0
    let d_val = mem_get_u8(buf, scales_off + j)
    let d = d_val - floor(d_val / 64.0) * 64.0
    let m_val = mem_get_u8(buf, scales_off + j + 4.0)
    let m = m_val - floor(m_val / 64.0) * 64.0
    sm[0] = d
    sm[1] = m
  else
    let qj4 = mem_get_u8(buf, scales_off + j + 4.0)
    let qj_4 = mem_get_u8(buf, scales_off + j - 4.0)
    let qj0 = mem_get_u8(buf, scales_off + j)
    let low_d = qj4 - floor(qj4 / 16.0) * 16.0
    let high_d = floor(qj_4 / 64.0)
    sm[0] = low_d + high_d * 16.0
    let low_m = floor(qj4 / 16.0)
    let high_m = floor(qj0 / 64.0)
    sm[1] = low_m + high_m * 16.0
  end
  return sm
end

fn dequant_q4k_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let dmin = read_f16_le_m(buf, block_off + 2.0)
  let scales_off = block_off + 4.0
  let qs_off = block_off + 16.0

  let mut _dq4_out = []
  let mut is_idx = 0.0
  let mut q_off = qs_off

  let mut j = 0.0
  while j < 4.0
    let sm1 = get_scale_min_k4_m(is_idx, buf, scales_off)
    let d1 = d * sm1[0]
    let m1 = dmin * sm1[1]
    let sm2 = get_scale_min_k4_m(is_idx + 1.0, buf, scales_off)
    let d2 = d * sm2[0]
    let m2 = dmin * sm2[1]

    let mut l = 0.0
    while l < 32.0
      let q_byte = mem_get_u8(buf, q_off + l)
      let q_low = q_byte - floor(q_byte / 16.0) * 16.0
      push(_dq4_out, d1 * q_low - m1)
      l = l + 1.0
    end

    let mut l2 = 0.0
    while l2 < 32.0
      let q_byte2 = mem_get_u8(buf, q_off + l2)
      let q_high = floor(q_byte2 / 16.0)
      push(_dq4_out, d2 * q_high - m2)
      l2 = l2 + 1.0
    end

    q_off = q_off + 32.0
    is_idx = is_idx + 2.0
    j = j + 1.0
  end
  return _dq4_out
end

// ── bit helper for the 5-bit formats ───────────────────────────
// Shift-and-mask one byte at a time. Assembling the four qh bytes into one word would be wrong
// here: numbers in this language are f32, so bits above the 24th would be discarded silently.
fn bit_at_m(buf, off, shift)
  let bit_byte = mem_get_u8(buf, off)
  let mut bit_left = shift
  let mut bit_cur = bit_byte
  while bit_left > 0.0
    bit_cur = floor(bit_cur / 2.0)
    bit_left = bit_left - 1.0
  end
  return bit_cur - 2.0 * floor(bit_cur / 2.0)
end

// ── MEM-based Q4_0 / Q4_1 / Q5_1 / Q5_K dequant ────────────────

fn dequant_q4_0_block_m(buf, block_off)
  // 32 weights from 18 bytes: d f16 @0, qs[16] @2. Byte j carries weight j in its low nibble and
  // weight j + 16 in its high nibble, so the two halves are emitted as two runs, not as pairs.
  let q40_d = read_f16_le_m(buf, block_off)
  let mut q40_out = []
  let mut q40_j = 0.0
  while q40_j < 16.0
    let q40_b = mem_get_u8(buf, block_off + 2.0 + q40_j)
    push(q40_out, q40_d * (q40_b - floor(q40_b / 16.0) * 16.0 - 8.0))
    q40_j = q40_j + 1.0
  end
  let mut q40_k = 0.0
  while q40_k < 16.0
    let q40_b2 = mem_get_u8(buf, block_off + 2.0 + q40_k)
    push(q40_out, q40_d * (floor(q40_b2 / 16.0) - 8.0))
    q40_k = q40_k + 1.0
  end
  return q40_out
end

fn dequant_q4_1_block_m(buf, block_off)
  // 32 weights from 20 bytes: d f16 @0, m f16 @2, qs[16] @4. Same half-and-half order as q4_0:
  // x = d * q + m, low nibble first for weights 0..15, high nibble for 16..31.
  let q41_d = read_f16_le_m(buf, block_off)
  let q41_m = read_f16_le_m(buf, block_off + 2.0)
  let mut q41_out = []
  let mut q41_j = 0.0
  while q41_j < 16.0
    let q41_b = mem_get_u8(buf, block_off + 4.0 + q41_j)
    push(q41_out, q41_d * (q41_b - floor(q41_b / 16.0) * 16.0) + q41_m)
    q41_j = q41_j + 1.0
  end
  let mut q41_k = 0.0
  while q41_k < 16.0
    let q41_b2 = mem_get_u8(buf, block_off + 4.0 + q41_k)
    push(q41_out, q41_d * floor(q41_b2 / 16.0) + q41_m)
    q41_k = q41_k + 1.0
  end
  return q41_out
end

fn dequant_q5_1_block_m(buf, block_off)
  // 32 weights from 24 bytes: d f16 @0, m f16 @2, h[4] @4 (the 5th bit of each weight), qs[16] @8.
  // Weight j takes bit j of h and the low nibble of qs[j]; weight j + 16 takes bit j + 16 and the
  // high nibble of qs[j]. The 5th bit is read per byte on purpose: numbers here are f32, so joining
  // the four h bytes into one word would discard bits past the 24th.
  let q51_d = read_f16_le_m(buf, block_off)
  let q51_m = read_f16_le_m(buf, block_off + 2.0)
  let mut q51_out = []
  let mut q51_j = 0.0
  while q51_j < 16.0
    let q51_b = mem_get_u8(buf, block_off + 8.0 + q51_j)
    let q51_gb = floor(q51_j / 8.0)
    let q51_bit = bit_at_m(buf, block_off + 4.0 + q51_gb, q51_j - 8.0 * q51_gb)
    push(q51_out, q51_d * (q51_b - floor(q51_b / 16.0) * 16.0 + 16.0 * q51_bit) + q51_m)
    q51_j = q51_j + 1.0
  end
  let mut q51_k = 0.0
  while q51_k < 16.0
    let q51_pos = q51_k + 16.0
    let q51_b2 = mem_get_u8(buf, block_off + 8.0 + q51_k)
    let q51_gb2 = floor(q51_pos / 8.0)
    let q51_bit2 = bit_at_m(buf, block_off + 4.0 + q51_gb2, q51_pos - 8.0 * q51_gb2)
    push(q51_out, q51_d * (floor(q51_b2 / 16.0) + 16.0 * q51_bit2) + q51_m)
    q51_k = q51_k + 1.0
  end
  return q51_out
end

fn dequant_q5_k_block_m(buf, block_off)
  // 256 weights from 176 bytes, as dequantize_row_q5_K does: d f16 @0, dmin f16 @2, scales[12] @4,
  // qh[32] @16, qs[128] @48. Four groups of 64 weights, two 32-weight sub-blocks each, sharing the
  // same 32 qh bytes: group g takes bit 2g of qh[l] for the low nibble and bit 2g+1 for the high.
  // The per-sub-block scale and min come from get_scale_min_k4, the same helper q4_K uses.
  let q5k_d = read_f16_le_m(buf, block_off)
  let q5k_min = read_f16_le_m(buf, block_off + 2.0)
  let q5k_sc = block_off + 4.0
  let q5k_qh = block_off + 16.0
  let q5k_qs = block_off + 48.0
  let mut q5k_out = []
  let mut q5k_g = 0.0
  let mut q5k_is = 0.0
  while q5k_g < 4.0
    let q5k_s1 = get_scale_min_k4_m(q5k_is, buf, q5k_sc)
    let q5k_d1 = q5k_d * q5k_s1[0]
    let q5k_m1 = q5k_min * q5k_s1[1]
    let q5k_s2 = get_scale_min_k4_m(q5k_is + 1.0, buf, q5k_sc)
    let q5k_d2 = q5k_d * q5k_s2[0]
    let q5k_m2 = q5k_min * q5k_s2[1]
    let q5k_b1 = 2.0 * q5k_g
    let q5k_b2 = 2.0 * q5k_g + 1.0
    let mut q5k_l = 0.0
    while q5k_l < 32.0
      let q5k_byte = mem_get_u8(buf, q5k_qs + q5k_g * 32.0 + q5k_l)
      let q5k_lo = q5k_byte - floor(q5k_byte / 16.0) * 16.0
      let q5k_hi = floor(q5k_byte / 16.0)
      let q5k_h1 = bit_at_m(buf, q5k_qh + q5k_l, q5k_b1)
      push(q5k_out, q5k_d1 * (q5k_lo + 16.0 * q5k_h1) - q5k_m1)
      q5k_l = q5k_l + 1.0
    end
    let mut q5k_l2 = 0.0
    while q5k_l2 < 32.0
      let q5k_byte2 = mem_get_u8(buf, q5k_qs + q5k_g * 32.0 + q5k_l2)
      let q5k_hi2 = floor(q5k_byte2 / 16.0)
      let q5k_h2 = bit_at_m(buf, q5k_qh + q5k_l2, q5k_b2)
      push(q5k_out, q5k_d2 * (q5k_hi2 + 16.0 * q5k_h2) - q5k_m2)
      q5k_l2 = q5k_l2 + 1.0
    end
    q5k_is = q5k_is + 2.0
    q5k_g = q5k_g + 1.0
  end
  return q5k_out
end

fn dequant_q2_k_block_m(buf, block_off)
  // 256 weights from 84 bytes, as dequantize_row_q2_K does: scales[16] @0, qs[64] @16,
  // d f16 @80, dmin f16 @82. Sixteen sub-blocks of 16 weights, two per scale byte:
  // dl = d * (s & 0xF) and ml = dmin * (s >> 4). Two passes of 128 weights, each consuming four
  // scale bytes and shifting by 0, 2, 4, 6 into the same 2-bit fields.
  // Field order is scales, quants, then the two halves -- NOT scale-first like q4_K/q5_K.
  let q2k_d = read_f16_le_m(buf, block_off + 80.0)
  let q2k_min = read_f16_le_m(buf, block_off + 82.0)
  let mut q2k_out = []
  let mut q2k_n = 0.0
  while q2k_n < 2.0
    let q2k_q = block_off + 16.0 + q2k_n * 32.0
    let mut q2k_j = 0.0
    while q2k_j < 4.0
      let mut q2k_p = 1.0
      let mut q2k_psh = 2.0 * q2k_j
      while q2k_psh > 0.0
        q2k_p = q2k_p * 2.0
        q2k_psh = q2k_psh - 1.0
      end
      let mut q2k_k = 0.0
      while q2k_k < 2.0
        let q2k_sc = mem_get_u8(buf, block_off + q2k_n * 8.0 + q2k_j * 2.0 + q2k_k)
        let q2k_dl = q2k_d * (q2k_sc - floor(q2k_sc / 16.0) * 16.0)
        let q2k_ml = q2k_min * floor(q2k_sc / 16.0)
        let q2k_boff = q2k_q + q2k_k * 16.0
        let mut q2k_l = 0.0
        while q2k_l < 16.0
          let q2k_b = mem_get_u8(buf, q2k_boff + q2k_l)
          let q2k_sh = floor(q2k_b / q2k_p)
          let q2k_v = q2k_sh - 4.0 * floor(q2k_sh / 4.0)
          push(q2k_out, q2k_dl * q2k_v - q2k_ml)
          q2k_l = q2k_l + 1.0
        end
        q2k_k = q2k_k + 1.0
      end
      q2k_j = q2k_j + 1.0
    end
    q2k_n = q2k_n + 1.0
  end
  return q2k_out
end

// ── MEM-based TQ1_0 / TQ2_0 dequant (ternary, no code book) ─────
// dequantize_row_tq1_0 / dequantize_row_tq2_0 are pure arithmetic, so these need no lookup tables:
// a byte times 3^n, truncated to 8 bits, then xi = (q * 3) >> 8 gives -1, 0 or +1 directly.

fn tq_pow3(n)
  let mut t = 1.0
  let mut k = 0.0
  while k < n
    t = t * 3.0
    k = k + 1.0
  end
  return t
end

fn dequant_tq1_0_block_m(buf, block_off)
  // 256 weights from 54 bytes, as dequantize_row_tq1_0 does: qs[48] @0, qh[4] @48, d f16 @52.
  // The 48 qs bytes split 32 + 16 because the source loops are written in multiples of 32 and 16;
  // each run multiplies the byte by 3^n (n = 0..4, or 0..3 for qh) and keeps only the low 8 bits.
  let t1_d = read_f16_le_m(buf, block_off + 52.0)
  let mut t1_out = []
  let mut t1_g = 0.0
  while t1_g < 2.0
    let t1_base = block_off + t1_g * 32.0
    let mut t1_len = 32.0
    if t1_g == 1.0
      t1_len = 16.0
    end
    let mut t1_n = 0.0
    while t1_n < 5.0
      let t1_p = tq_pow3(t1_n)
      let mut t1_m = 0.0
      while t1_m < t1_len
        let t1_b = mem_get_u8(buf, t1_base + t1_m)
        let t1_qraw = t1_b * t1_p
        let t1_q = t1_qraw - 256.0 * floor(t1_qraw / 256.0)
        let t1_xi = floor(t1_q * 3.0 / 256.0)
        push(t1_out, (t1_xi - 1.0) * t1_d)
        t1_m = t1_m + 1.0
      end
      t1_n = t1_n + 1.0
    end
    t1_g = t1_g + 1.0
  end
  let mut t1_h = 0.0
  while t1_h < 4.0
    let t1_hp = tq_pow3(t1_h)
    let mut t1_j = 0.0
    while t1_j < 4.0
      let t1_hb = mem_get_u8(buf, block_off + 48.0 + t1_j)
      let t1_hr = t1_hb * t1_hp
      let t1_hq = t1_hr - 256.0 * floor(t1_hr / 256.0)
      let t1_hxi = floor(t1_hq * 3.0 / 256.0)
      push(t1_out, (t1_hxi - 1.0) * t1_d)
      t1_j = t1_j + 1.0
    end
    t1_h = t1_h + 1.0
  end
  return t1_out
end

fn dequant_tq2_0_block_m(buf, block_off)
  // 256 weights from 66 bytes: qs[64] @0 (2 bits per weight), d f16 @64. Two runs of 128 weights;
  // within a run the four bit-pairs are taken in order across all 32 bytes, so element order is
  // byte-major per pair, not pair-major per byte.
  let t2_d = read_f16_le_m(buf, block_off + 64.0)
  let mut t2_out = []
  let mut t2_g = 0.0
  while t2_g < 2.0
    let mut t2_l = 0.0
    while t2_l < 4.0
      let mut t2_p = 1.0
      let mut t2_sh = 2.0 * t2_l
      while t2_sh > 0.0
        t2_p = t2_p * 2.0
        t2_sh = t2_sh - 1.0
      end
      let mut t2_m = 0.0
      while t2_m < 32.0
        let t2_b = mem_get_u8(buf, block_off + t2_g * 32.0 + t2_m)
        let t2_s = floor(t2_b / t2_p)
        let t2_q = t2_s - 4.0 * floor(t2_s / 4.0)
        push(t2_out, (t2_q - 1.0) * t2_d)
        t2_m = t2_m + 1.0
      end
      t2_l = t2_l + 1.0
    end
    t2_g = t2_g + 1.0
  end
  return t2_out
end

fn dequant_q2_0_g128_block_m(buf, block_off)
  // 128 weights from 34 bytes: d f16 @0, qs[32] @2, two bits per weight. The code is not the usual
  // offset-binary one -- dequantize_row_q2_0_g128 maps 00=-1, 01=0, 10=+1, 11=+2, i.e. (q - 1) * d,
  // so a block can represent a ternary weight set plus one spare code.
  let g1_d = read_f16_le_m(buf, block_off)
  let mut g1_out = []
  let mut g1_w = 0.0
  while g1_w < 32.0
    let g1_b = mem_get_u8(buf, block_off + 2.0 + g1_w)
    let mut g1_k = 0.0
    while g1_k < 4.0
      let mut g1_p = 1.0
      let mut g1_sh = 2.0 * g1_k
      while g1_sh > 0.0
        g1_p = g1_p * 2.0
        g1_sh = g1_sh - 1.0
      end
      let g1_s = floor(g1_b / g1_p)
      let g1_q = g1_s - 4.0 * floor(g1_s / 4.0)
      push(g1_out, (g1_q - 1.0) * g1_d)
      g1_k = g1_k + 1.0
    end
    g1_w = g1_w + 1.0
  end
  return g1_out
end

// ── MEM-based Q8_0 / Q5_0 / BF16 dequant ────────────────────────
// Block layouts and value formulas were confirmed element-by-element against ggml's own
// dequantization (an F32 re-quant of the same file), not from a recalled bit layout:
//   q8_0  34 B: d(f16)@0, int8 qs[32]@2         value = d * qs[i]
//   q5_0  22 B: d(f16)@0, u32 qh@2, qs[16]@6    lo nibbles of qs[0..15] -> elements 0..15,
//                                                hi nibbles -> elements 16..31, 5th bit = bit i of qh
//                                                value = (q - 16) * d
// Both nibble schemes and the 5th-bit index were the surprising parts (plane-split, not paired).

fn dequant_q8_0_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let mut out = []
  let mut i = 0.0
  while i < 32.0
    let raw = mem_get_u8(buf, block_off + 2.0 + i)
    let sv = raw - floor(raw / 128.0) * 256.0
    push(out, d * sv)
    i = i + 1.0
  end
  return out
end

fn dequant_q5_0_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off)
  let mut out = []
  let mut i = 0.0
  while i < 32.0
    let mut qs_idx = i
    if i >= 16.0
      qs_idx = i - 16.0
    end
    let byte = mem_get_u8(buf, block_off + 6.0 + qs_idx)
    let mut nib = byte - floor(byte / 16.0) * 16.0
    if i >= 16.0
      nib = floor(byte / 16.0)
    end
    // The 5th bit is bit (i mod 8) of the qh byte at (i div 8). Read and shifted per byte on
    // purpose: numbers here are f32, so combining the four bytes into one word would discard the
    // low bits of that word and silently drop the 5th bit for most elements.
    let qh_idx = floor(i / 8.0)
    let qbyte = mem_get_u8(buf, block_off + 2.0 + qh_idx)
    let mut sh = i - 8.0 * qh_idx
    let mut shifted = qbyte
    while sh > 0.0
      shifted = floor(shifted / 2.0)
      sh = sh - 1.0
    end
    let bit = shifted - 2.0 * floor(shifted / 2.0)
    let q = nib + 16.0 * bit
    push(out, (q - 16.0) * d)
    i = i + 1.0
  end
  return out
end

// q6_K: 256 weights from 210 bytes. Element e draws its low nibble from
// ql[64*ip + il + 32*(k mod 2)] (upper nibble when k >= 2) and its two high bits from
// qh[32*ip + il] >> 2*k, with ip = e div 128, k = (e mod 128) div 32, il = (e mod 128) mod 32.
// That scrambled mapping is ggml's to_q6_K; it was checked bit-exactly against an F32 re-quant.
fn dequant_q6_k_block_m(buf, block_off)
  let d = read_f16_le_m(buf, block_off + 208.0)
  let mut out = []
  let mut e = 0.0
  while e < 256.0
    let ip = floor(e / 128.0)
    let r = e - 128.0 * ip
    let k = floor(r / 32.0)
    let il = r - 32.0 * k
    let kb = k - 2.0 * floor(k / 2.0)
    let cell = mem_get_u8(buf, block_off + 64.0 * ip + il + 32.0 * kb)
    let mut q = cell - 16.0 * floor(cell / 16.0)
    if k >= 2.0
      q = floor(cell / 16.0)
    end
    // The two high bits are 2k..2k+1 of one qh byte. Divided out in f32 rather than assembled
    // into a 32-bit word: words built from bytes would overflow the exact-integer range of f32.
    let hib = mem_get_u8(buf, block_off + 128.0 + 32.0 * ip + il)
    let mut div = 1.0
    let mut sh = 0.0
    while sh < k
      div = div * 4.0
      sh = sh + 1.0
    end
    let moved = floor(hib / div)
    q = q + 16.0 * (moved - 4.0 * floor(moved / 4.0))
    let sraw = mem_get_u8(buf, block_off + 192.0 + floor(e / 16.0))
    let s = sraw - 256.0 * floor(sraw / 128.0)
    push(out, d * s * (q - 32.0))
    e = e + 1.0
  end
  return out
end

// ── Load tensor from file (no OOM) ──────────────────────────────
// Reads raw bytes from GGUF file, dequants to f32 array.
// Uses gguf_tensor_file_offset for u64-precise seeking.

fn load_tensor_from_file(file_path, model, tname)
  if gguf_has_tensor(model, tname) == 0.0
    print("WARNING: tensor not found: {tname}")
    let mut _ea3 = []
    return _ea3
  end

  let ttype = gguf_tensor_type(model, tname)
  let count = gguf_tensor_count(model, tname)
  let byte_size = gguf_tensor_byte_size(model, tname)

  // Get precise u64 file offset
  let off_buf = gguf_tensor_file_offset(model, tname)

  // Allocate temp buffer and read raw bytes from file
  let raw = mem_alloc(byte_size)
  let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, byte_size)
  mem_free(off_buf)

  // Dequant based on type
  let mut result = []

  if ttype == 0.0
    // F32: read directly
    let mut i = 0.0
    while i < count
      let f = bits_to_float(mem_get_u32(raw, i * 4.0))
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 1.0
    // F16: convert each value
    let mut i = 0.0
    while i < count
      let f = read_f16_le_m(raw, i * 2.0)
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 30.0
    // BF16: one 16-bit value per element, exponent-biased like f32 with 8 bits of mantissa.
    let mut i = 0.0
    while i < count
      let b0 = mem_get_u8(raw, i * 2.0)
      let b1 = mem_get_u8(raw, i * 2.0 + 1.0)
      let f = bits_to_float((b0 + b1 * 256.0) * 65536.0)
      push(result, f)
      i = i + 1.0
    end
  elif ttype == 8.0
    // Q8_0: 32 weights from 34 bytes
    let mut b = 0.0
    while b < count / 32.0
      let vals = dequant_q8_0_block_m(raw, b * 34.0)
      let mut vi = 0.0
      while vi < len(vals)
        push(result, vals[int(vi)])
        vi = vi + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 6.0
    // Q5_0: 32 weights from 22 bytes
    let mut b = 0.0
    while b < count / 32.0
      let vals = dequant_q5_0_block_m(raw, b * 22.0)
      let mut vi = 0.0
      while vi < len(vals)
        push(result, vals[int(vi)])
        vi = vi + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 12.0
    // Q4_K: inline dequant — no function calls to avoid O(n^2) clone overhead
    // Q4_K block: 256 weights from 144 bytes
    // Layout: d(f16,2B) + dmin(f16,2B) + scales(12B) + qs(128B) = 144
    let block_size = 256.0
    let block_bytes = 144.0
    let n_blocks = ceil(count / block_size)
    let mut b = 0.0
    while b < n_blocks
      let bo = b * block_bytes
      // Inline F16 decode for d
      let db0 = mem_get_u8(raw, bo)
      let db1 = mem_get_u8(raw, bo + 1.0)
      let d_bits = db0 + db1 * 256.0
      let d_sign = floor(d_bits / 32768.0)
      let d_rem = d_bits - d_sign * 32768.0
      let d_exp = floor(d_rem / 1024.0)
      let d_man = d_rem - d_exp * 1024.0
      let mut d_val = 0.0
      if d_exp > 0.0
        if d_exp < 31.0
          d_val = (1.0 + d_man / 1024.0) * pow(2.0, d_exp - 15.0)
          if d_sign == 1.0
            d_val = d_val * -1.0
          end
        end
      end
      // Inline F16 decode for dmin
      let mb0 = mem_get_u8(raw, bo + 2.0)
      let mb1 = mem_get_u8(raw, bo + 3.0)
      let m_bits = mb0 + mb1 * 256.0
      let m_sign = floor(m_bits / 32768.0)
      let m_rem = m_bits - m_sign * 32768.0
      let m_exp = floor(m_rem / 1024.0)
      let m_man = m_rem - m_exp * 1024.0
      let mut dm_val = 0.0
      if m_exp > 0.0
        if m_exp < 31.0
          dm_val = (1.0 + m_man / 1024.0) * pow(2.0, m_exp - 15.0)
          if m_sign == 1.0
            dm_val = dm_val * -1.0
          end
        end
      end
      let sc_off = bo + 4.0
      let qs_off = bo + 16.0
      // 4 sub-block pairs × 64 weights = 256
      let mut j = 0.0
      let mut q_ptr = qs_off
      let mut is_idx = 0.0
      while j < 4.0
        // Decode scale/min for sub-block pair (inline get_scale_min_k4_m)
        let mut sc1 = 0.0
        let mut mn1 = 0.0
        if is_idx < 4.0
          let sv1 = mem_get_u8(raw, sc_off + is_idx)
          sc1 = sv1 - floor(sv1 / 64.0) * 64.0
          let mv1 = mem_get_u8(raw, sc_off + is_idx + 4.0)
          mn1 = mv1 - floor(mv1 / 64.0) * 64.0
        else
          let qj4_1 = mem_get_u8(raw, sc_off + is_idx + 4.0)
          let qj_4_1 = mem_get_u8(raw, sc_off + is_idx - 4.0)
          let qj0_1 = mem_get_u8(raw, sc_off + is_idx)
          sc1 = (qj4_1 - floor(qj4_1 / 16.0) * 16.0) + floor(qj_4_1 / 64.0) * 16.0
          mn1 = floor(qj4_1 / 16.0) + floor(qj0_1 / 64.0) * 16.0
        end
        let d1 = d_val * sc1
        let m1 = dm_val * mn1
        // Second sub-block
        let is2 = is_idx + 1.0
        let mut sc2 = 0.0
        let mut mn2 = 0.0
        if is2 < 4.0
          let sv2 = mem_get_u8(raw, sc_off + is2)
          sc2 = sv2 - floor(sv2 / 64.0) * 64.0
          let mv2 = mem_get_u8(raw, sc_off + is2 + 4.0)
          mn2 = mv2 - floor(mv2 / 64.0) * 64.0
        else
          let qj4_2 = mem_get_u8(raw, sc_off + is2 + 4.0)
          let qj_4_2 = mem_get_u8(raw, sc_off + is2 - 4.0)
          let qj0_2 = mem_get_u8(raw, sc_off + is2)
          sc2 = (qj4_2 - floor(qj4_2 / 16.0) * 16.0) + floor(qj_4_2 / 64.0) * 16.0
          mn2 = floor(qj4_2 / 16.0) + floor(qj0_2 / 64.0) * 16.0
        end
        let d2 = d_val * sc2
        let m2 = dm_val * mn2
        // 32 weights from low nibbles
        let mut l = 0.0
        while l < 32.0
          let qb = mem_get_u8(raw, q_ptr + l)
          push(result, d1 * (qb - floor(qb / 16.0) * 16.0) - m1)
          l = l + 1.0
        end
        // 32 weights from high nibbles
        let mut l2 = 0.0
        while l2 < 32.0
          let qb2 = mem_get_u8(raw, q_ptr + l2)
          push(result, d2 * floor(qb2 / 16.0) - m2)
          l2 = l2 + 1.0
        end
        q_ptr = q_ptr + 32.0
        is_idx = is_idx + 2.0
        j = j + 1.0
      end
      b = b + 1.0
    end
  elif ttype == 2.0
    // Q4_0: 32 or 256 weights per block, 18.0 bytes each
    let mut bq40 = 0.0
    let mut blkq40 = 18.0
    while bq40 < count / 32.0
      let vq40 = dequant_q4_0_block_m(raw, blkq40)
      let mut iq40 = 0.0
      while iq40 < len(vq40)
        push(result, vq40[int(iq40)])
        iq40 = iq40 + 1.0
      end
      bq40 = bq40 + 1.0
      blkq40 = blkq40 + 18.0
    end
  elif ttype == 3.0
    // Q4_1: 32 or 256 weights per block, 20.0 bytes each
    let mut bq41 = 0.0
    let mut blkq41 = 20.0
    while bq41 < count / 32.0
      let vq41 = dequant_q4_1_block_m(raw, blkq41)
      let mut iq41 = 0.0
      while iq41 < len(vq41)
        push(result, vq41[int(iq41)])
        iq41 = iq41 + 1.0
      end
      bq41 = bq41 + 1.0
      blkq41 = blkq41 + 20.0
    end
  elif ttype == 7.0
    // Q5_1: 32 or 256 weights per block, 24.0 bytes each
    let mut bq51 = 0.0
    let mut blkq51 = 24.0
    while bq51 < count / 32.0
      let vq51 = dequant_q5_1_block_m(raw, blkq51)
      let mut iq51 = 0.0
      while iq51 < len(vq51)
        push(result, vq51[int(iq51)])
        iq51 = iq51 + 1.0
      end
      bq51 = bq51 + 1.0
      blkq51 = blkq51 + 24.0
    end
  elif ttype == 13.0
    // Q5_K: 32 or 256 weights per block, 176.0 bytes each
    let mut bq5kb = 0.0
    let mut blkq5kb = 176.0
    while bq5kb < count / 256.0
      let vq5kb = dequant_q5_k_block_m(raw, blkq5kb)
      let mut iq5kb = 0.0
      while iq5kb < len(vq5kb)
        push(result, vq5kb[int(iq5kb)])
        iq5kb = iq5kb + 1.0
      end
      bq5kb = bq5kb + 1.0
      blkq5kb = blkq5kb + 176.0
    end
  elif ttype == 10.0
    // Q2_K: 256 weights from 84-byte blocks
    let mut bq2k = 0.0
    let mut blkq2k = 0.0
    while bq2k < count / 256.0
      let vq2k = dequant_q2_k_block_m(raw, blkq2k)
      let mut iq2k = 0.0
      while iq2k < len(vq2k)
        push(result, vq2k[int(iq2k)])
        iq2k = iq2k + 1.0
      end
      bq2k = bq2k + 1.0
      blkq2k = blkq2k + 84.0
    end
  elif ttype == 34.0
    // TQ1_0: 256 weights per 54-byte block
    let mut btq1_0 = 0.0
    let mut blktq1_0 = 0.0
    while btq1_0 < count / 256.0
      let vtq1_0 = dequant_tq1_0_block_m(raw, blktq1_0)
      let mut itq1_0 = 0.0
      while itq1_0 < len(vtq1_0)
        push(result, vtq1_0[int(itq1_0)])
        itq1_0 = itq1_0 + 1.0
      end
      btq1_0 = btq1_0 + 1.0
      blktq1_0 = blktq1_0 + 54.0
    end
  elif ttype == 35.0
    // TQ2_0: 256 weights per 66-byte block
    let mut btq2_0 = 0.0
    let mut blktq2_0 = 0.0
    while btq2_0 < count / 256.0
      let vtq2_0 = dequant_tq2_0_block_m(raw, blktq2_0)
      let mut itq2_0 = 0.0
      while itq2_0 < len(vtq2_0)
        push(result, vtq2_0[int(itq2_0)])
        itq2_0 = itq2_0 + 1.0
      end
      btq2_0 = btq2_0 + 1.0
      blktq2_0 = blktq2_0 + 66.0
    end
  elif ttype == 142.0
    // Q2_0_g128 (PQ2_0): 128 weights per 34-byte block
    let mut bg1 = 0.0
    let mut blkg1 = 0.0
    while bg1 < count / 128.0
      let vg1 = dequant_q2_0_g128_block_m(raw, blkg1)
      let mut ig1 = 0.0
      while ig1 < len(vg1)
        push(result, vg1[int(ig1)])
        ig1 = ig1 + 1.0
      end
      bg1 = bg1 + 1.0
      blkg1 = blkg1 + 34.0
    end
  elif ttype == 14.0
    // Q6_K: 256 weights per 210-byte block, count may end mid-block
    let mut b6 = 0.0
    while b6 < ceil(count / 256.0)
      let vals6 = dequant_q6_k_block_m(raw, b6 * 210.0)
      let mut n6 = 256.0
      let left6 = count - b6 * 256.0
      if left6 < n6
        n6 = left6
      end
      let mut vi6 = 0.0
      while vi6 < n6
        push(result, vals6[int(vi6)])
        vi6 = vi6 + 1.0
      end
      b6 = b6 + 1.0
    end
  else
    assert(false, "load_tensor_from_file: no decoder for ggml type " + str(ttype) + " of " + tname + " (this loader implements F32, F16, BF16, Q4_0, Q4_1, Q5_0, Q5_1, Q8_0, Q2_K, Q4_K, Q5_K, Q6_K, TQ1_0, TQ2_0 and Q2_0_g128)")
  end

  mem_free(raw)
  return result
end

// ── Load embedding row from file ─────────────────────────────────

fn load_embedding_row_from_file(file_path, model, token_id, n_embd)
  let emb_name = "token_embd.weight"
  if gguf_has_tensor(model, emb_name) == 0.0
    // A zero row is a correctly shaped embedding that says nothing about the token, which is the
    // failure mode this loader exists not to hide.
    assert(false, "load_embedding_row_from_file: token_embd.weight not found in this model")
    return []
  end

  let ttype = gguf_tensor_type(model, emb_name)
  let off_buf = gguf_tensor_file_offset(model, emb_name)

  if ttype == 0.0
    // F32: read one row (token_id * n_embd * 4 bytes)
    let row_byte_off = token_id * n_embd * 4.0
    // Add row offset to file offset
    let row_off = mem_alloc(8)
    mem_set_u64(row_off, 0.0, row_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, row_off, 0.0)
    mem_free(row_off)

    let row_bytes = n_embd * 4.0
    let raw = mem_alloc(row_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, row_bytes)
    mem_free(off_buf)

    let mut row = []
    let mut i = 0.0
    while i < n_embd
      let f = bits_to_float(mem_get_u32(raw, i * 4.0))
      push(row, f)
      i = i + 1.0
    end
    mem_free(raw)
    return row
  elif ttype == 1.0
    // F16: row_offset = token_id * n_embd * 2
    let row_byte_off = token_id * n_embd * 2.0
    let row_off = mem_alloc(8)
    mem_set_u64(row_off, 0.0, row_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, row_off, 0.0)
    mem_free(row_off)

    let row_bytes = n_embd * 2.0
    let raw = mem_alloc(row_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, row_bytes)
    mem_free(off_buf)

    let mut row = []
    let mut i = 0.0
    while i < n_embd
      let f = read_f16_le_m(raw, i * 2.0)
      push(row, f)
      i = i + 1.0
    end
    mem_free(raw)
    return row
  elif ttype == 12.0
    // Q4_K: find the block(s) containing this row
    let block_size = 256.0
    let block_bytes = 144.0
    let weight_idx = token_id * n_embd
    let block_idx = floor(weight_idx / block_size)
    let weights_end = weight_idx + n_embd
    let blocks_needed = ceil((weights_end - block_idx * block_size) / block_size)

    // Read just the needed blocks
    let read_bytes_count = blocks_needed * block_bytes
    let block_byte_off = block_idx * block_bytes
    let blk_off = mem_alloc(8)
    mem_set_u64(blk_off, 0.0, block_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, blk_off, 0.0)
    mem_free(blk_off)

    let raw = mem_alloc(read_bytes_count)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, read_bytes_count)
    mem_free(off_buf)

    // Dequant and extract row
    let mut all_weights = []
    let mut b = 0.0
    while b < blocks_needed
      let bo = b * block_bytes
      let bdata = dequant_q4k_block_m(raw, bo)
      let mut bi = 0.0
      while bi < 256.0
        push(all_weights, bdata[int(bi)])
        bi = bi + 1.0
      end
      b = b + 1.0
    end
    mem_free(raw)

    let local_start = weight_idx - block_idx * block_size
    let mut row = []
    let mut i = 0.0
    while i < n_embd
      push(row, all_weights[int(local_start + i)])
      i = i + 1.0
    end
    return row
  elif ttype == 14.0
    let q6_block_bytes = 210.0
    let weight_idx = token_id * n_embd
    let block_idx = floor(weight_idx / 256.0)
    let blocks_needed = ceil((weight_idx + n_embd - block_idx * 256.0) / 256.0)
    let blk_off = mem_alloc(8)
    mem_set_u64(blk_off, 0.0, block_idx * q6_block_bytes)
    let _a = mem_u64_add(off_buf, 0.0, blk_off, 0.0)
    mem_free(blk_off)
    let raw = mem_alloc(blocks_needed * q6_block_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, blocks_needed * q6_block_bytes)
    mem_free(off_buf)
    let mut all_weights = []
    let mut blki = 0.0
    while blki < blocks_needed
      let vals6 = dequant_q6_k_block_m(raw, blki * q6_block_bytes)
      let mut vi6 = 0.0
      while vi6 < 256.0
        push(all_weights, vals6[int(vi6)])
        vi6 = vi6 + 1.0
      end
      blki = blki + 1.0
    end
    mem_free(raw)
    let local_start = weight_idx - block_idx * 256.0
    let mut row = []
    let mut i = 0.0
    while i < n_embd
      push(row, all_weights[int(local_start + i)])
      i = i + 1.0
    end
    return row
  end

  mem_free(off_buf)
  assert(false, "load_embedding_row_from_file: no decoder for ggml type " + str(ttype) + " of " + emb_name + " (this path implements F32, F16, Q4_K and Q6_K)")
  return []
end

// ── Generic tensor row loader ─────────────────────────────────────
// Loads row `row_idx` (of `row_size` elements) from tensor `tname`.
// Works for any GGUF tensor — parameterized version of load_embedding_row_from_file.
// Used by streaming matmul for CPU-only inference (O(row_size) memory per call).

fn load_tensor_row_from_file(file_path, model, tname, row_idx, row_size)
  if gguf_has_tensor(model, tname) == 0.0
    print("ERROR: tensor not found: {tname}")
    let mut _trz = []
    let mut _zi = 0.0
    while _zi < row_size
      push(_trz, 0.0)
      _zi = _zi + 1.0
    end
    return _trz
  end

  let ttype = gguf_tensor_type(model, tname)
  let off_buf = gguf_tensor_file_offset(model, tname)

  if ttype == 0.0
    let row_byte_off = row_idx * row_size * 4.0
    let row_off = mem_alloc(8)
    mem_set_u64(row_off, 0.0, row_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, row_off, 0.0)
    mem_free(row_off)
    let row_bytes = row_size * 4.0
    let raw = mem_alloc(row_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, row_bytes)
    mem_free(off_buf)
    let mut _trf = []
    let mut _ti = 0.0
    while _ti < row_size
      push(_trf, bits_to_float(mem_get_u32(raw, _ti * 4.0)))
      _ti = _ti + 1.0
    end
    mem_free(raw)
    return _trf
  elif ttype == 1.0
    let row_byte_off = row_idx * row_size * 2.0
    let row_off = mem_alloc(8)
    mem_set_u64(row_off, 0.0, row_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, row_off, 0.0)
    mem_free(row_off)
    let row_bytes = row_size * 2.0
    let raw = mem_alloc(row_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, row_bytes)
    mem_free(off_buf)
    let mut _trf = []
    let mut _ti = 0.0
    while _ti < row_size
      push(_trf, read_f16_le_m(raw, _ti * 2.0))
      _ti = _ti + 1.0
    end
    mem_free(raw)
    return _trf
  elif ttype == 12.0
    let block_size = 256.0
    let block_bytes = 144.0
    let weight_idx = row_idx * row_size
    let block_idx = floor(weight_idx / block_size)
    let weights_end = weight_idx + row_size
    let blocks_needed = ceil((weights_end - block_idx * block_size) / block_size)
    let read_bytes_count = blocks_needed * block_bytes
    let block_byte_off = block_idx * block_bytes
    let blk_off = mem_alloc(8)
    mem_set_u64(blk_off, 0.0, block_byte_off)
    let _a = mem_u64_add(off_buf, 0.0, blk_off, 0.0)
    mem_free(blk_off)
    let raw = mem_alloc(read_bytes_count)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, read_bytes_count)
    mem_free(off_buf)
    let mut _trw = []
    let mut b = 0.0
    while b < blocks_needed
      let bo = b * block_bytes
      let bdata = dequant_q4k_block_m(raw, bo)
      let mut bi = 0.0
      while bi < 256.0
        push(_trw, bdata[int(bi)])
        bi = bi + 1.0
      end
      b = b + 1.0
    end
    mem_free(raw)
    let local_start = weight_idx - block_idx * block_size
    let mut _trf = []
    let mut _ti = 0.0
    while _ti < row_size
      push(_trf, _trw[int(local_start + _ti)])
      _ti = _ti + 1.0
    end
    return _trf
  elif ttype == 14.0
    let q6_block_bytes = 210.0
    let weight_idx = row_idx * row_size
    let block_idx = floor(weight_idx / 256.0)
    let blocks_needed = ceil((weight_idx + row_size - block_idx * 256.0) / 256.0)
    let blk_off = mem_alloc(8)
    mem_set_u64(blk_off, 0.0, block_idx * q6_block_bytes)
    let _a = mem_u64_add(off_buf, 0.0, blk_off, 0.0)
    mem_free(blk_off)
    let raw = mem_alloc(blocks_needed * q6_block_bytes)
    let _rd = file_read_into_mem_u64(file_path, raw, off_buf, 0.0, blocks_needed * q6_block_bytes)
    mem_free(off_buf)
    let mut _trw = []
    let mut blki = 0.0
    while blki < blocks_needed
      let vals6 = dequant_q6_k_block_m(raw, blki * q6_block_bytes)
      let mut vi6 = 0.0
      while vi6 < 256.0
        push(_trw, vals6[int(vi6)])
        vi6 = vi6 + 1.0
      end
      blki = blki + 1.0
    end
    mem_free(raw)
    let local_start = weight_idx - block_idx * 256.0
    let mut _trf = []
    let mut _ti = 0.0
    while _ti < row_size
      push(_trf, _trw[int(local_start + _ti)])
      _ti = _ti + 1.0
    end
    return _trf
  end

  mem_free(off_buf)
  assert(false, "load_tensor_row_from_file: no decoder for ggml type " + str(ttype) + " of " + tname + " (this path implements F32, F16, Q4_K and Q6_K)")
  return []
end

// ══════════════════════════════════════════════════════════════════════
// FAST TENSOR LOADING — Rust OS-boundary dequant (v1.5.0)
// Use gguf_load_tensor(file_path, model, tensor_name) directly.
// It's a Rust builtin: returns GpuFloats array (never cloned).
// Supports: F32, F16, Q4_K, Q5_K (v1.5.0+), Q6_K
// API: gguf_load_tensor(file_path, model_map, "blk.0.attn_q.weight")
// ══════════════════════════════════════════════════════════════════════
